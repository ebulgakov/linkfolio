# Neon Postgres — from `npx neon env pull` or the Neon console
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (Better Auth backend)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
BETTER_AUTH_API_KEY=

# Vercel Blob (image uploads) — Vercel dashboard → Storage → Blob store → Connect to project,
# or `vercel env pull` for local dev
BLOB_READ_WRITE_TOKEN=

# Playwright e2e (scripts/neon-test-branch.mts) — dedicated, persistent Neon
# branch (e2e-test) reset from a schema-only base branch (e2e-base,
# NEON_RESET_SOURCE_BRANCH_ID) before and after every `pnpm test:e2e` run —
# never restored from main/prod, so e2e-test never carries real user data.
# e2e-base's schema must be kept in sync with prod's manually — see the
# migrations bullet in CLAUDE.md. Neon Auth is project-scoped though, not
# per-branch (NEON_AUTH_BASE_URL/JWKS_URL above are shared with prod) — e2e
# signups DO land in prod's neon_auth.user table; run `pnpm cleanup:e2e-users`
# periodically to remove them (scripts/cleanup-e2e-users.mjs). Only needed for
# e2e; goes in `.env.e2e.local` locally (gitignored), not `.env`.
NEON_API_KEY=
NEON_TEST_BRANCH_ID=
NEON_RESET_SOURCE_BRANCH_ID=
TEST_DATABASE_URL=
# Pooled connection string for e2e-base — reference only for the manual
# schema-sync step above (derive the unpooled form yourself when needed);
# not read by any script.
TEST_DATABASE_URL_BASE=
