# Neon Postgres — from `npx neon env pull` or the Neon console
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (Better Auth backend)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
BETTER_AUTH_API_KEY=

# Vercel Blob (image uploads) — Vercel dashboard → Storage → Blob store → Connect to project,
# or `vercel env pull` for local dev
BLOB_READ_WRITE_TOKEN=

# Playwright e2e (scripts/neon-test-branch.mts) — dedicated Neon branch (e2e-test)
# reset from a schema-only base branch (e2e-base, NEON_RESET_SOURCE_BRANCH_ID)
# before/after every `pnpm test:e2e` run — Postgres data (collections/urls/etc.)
# is fully isolated from prod this way. Neon Auth is project-scoped though, not
# per-branch (NEON_AUTH_BASE_URL/JWKS_URL above are shared with prod) — e2e
# signups DO land in prod's neon_auth.user table, tagged with an "e2e-" email
# prefix for manual cleanup (see e2e/auth.spec.ts). Only needed for e2e; goes
# in `.env.e2e.local` locally (gitignored), not `.env`.
NEON_API_KEY=
NEON_TEST_BRANCH_ID=
NEON_RESET_SOURCE_BRANCH_ID=
TEST_DATABASE_URL=
